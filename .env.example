# edgeconnect-mcp settings
#
# Save this file as ~/.edgeconnect-mcp/.env, fill in your values and keep it private
# (chmod 600 ~/.edgeconnect-mcp/.env).
# Never commit .env. It holds your Orchestrator API keys.
#
# Installed with setup.sh? Then setup.sh wrote ONE shared .env in the install folder, used by
# edgeconnect-auto, edgeconnect-preconfig and this server alike. Add the keys below to that file.
# The keys those two tools read are documented in their own repositories' .env.example; this
# file lists only what edgeconnect-mcp reads. Keys a tool does not know are ignored by it.
#
# Format rules:
#   - One KEY=value per line. Lines starting with # and blank lines are ignored.
#     A line without "=" stops the server with "invalid dotenv line N".
#   - A leading "export " is allowed (export lab_mcp_writes=true), so the file can be sourced.
#   - Put comments on their own line. Text after a value on the same line becomes part of the value.
#   - Quotes are optional: key="value", key='value' and key=value mean the same. A value that
#     starts with a quote must end with the same quote, or the server stops with
#     "unterminated dotenv quote on line N". Spaces around the key and the value are trimmed.
#   - If a key appears twice, the last one wins.
#   - Key names are not case-sensitive (LAB_MCP_WRITES = lab_mcp_writes), except the
#     single-Orchestrator keys in section 8, which must be spelled exactly as listed there.
#   - Environment variables with the same name override this file (handy with docker --env-file).
#   - Most problems stop the server at startup with a message naming the key. Section 9 lists
#     the values that are NOT checked and silently fall back to a default.
#
# The server (and `edgeconnect-mcp report`) reads the first of: --dotenv /absolute/path/.env,
# $EDGECONNECT_DOTENV, ~/.edgeconnect-mcp/.env, then ./.env in the folder it is started in.
# `report` has no keys of its own: it uses the Orchestrators and switches below, and its alarm
# archive folder is the --history command-line option (default ~/.edgeconnect-mcp/history).


# =====================================================================
# 1. Orchestrators (required)
# =====================================================================
#
# orch_<N>=<nickname>
#   Give each Orchestrator a numbered slot and a nickname: orch_1, orch_2, ... <N> is any
#   whole number; gaps are fine and the slots are taken in number order. An empty value
#   leaves the slot unused. A key that starts with orch_ but is not orch_<digits> or
#   orch_default (orch_two, orch_1a) stops the server: "Orchestrator slots must be numbered".
#
#   The nickname is what you and the assistant use ("show the appliances on lab"), and it
#   prefixes all of that Orchestrator's settings below. Accepted: lowercase letters, digits
#   and _ (uppercase is lowered: orch_1=Lab means lab). Not accepted, stops the server:
#   "-", ".", spaces, the reserved names default, orchestrator, edgeconnect, ec, and the same
#   nickname in two slots. Avoid "orch" and nicknames starting with "orch_": their settings
#   (orch_base_url) look like a slot and stop the server.
#
# Each Orchestrator needs both of these, or the server stops with
# "Orchestrator 'lab' (orch_1) needs both lab_base_url and lab_api_key":
#
#   <nickname>_base_url  https:// address of the Orchestrator: host, host:port, or either
#                        followed by /gms/rest (a trailing / is fine). Names and IP addresses
#                        both work. Refused at startup: http:// ("base URL must be an absolute
#                        HTTPS URL"), any other path ("base URL path must be empty or /gms/rest"),
#                        and a user:password@, ?query or #fragment in the URL.
#                        Examples: https://orchestrator.example.com
#                                  https://192.0.2.10:8443/gms/rest
#   <nickname>_api_key   a REST API key, any non-empty text, sent as is. Create it on the
#                        Orchestrator with the least privilege you need (read-only is enough for
#                        reads). How to create one:
#                        https://arubanetworking.hpe.com/techdocs/sdwan/docs/orch/orchestrator/server/api-key/

orch_1=lab
lab_base_url=https://<ORCHESTRATOR_FQDN_OR_IP>
lab_api_key=<API_KEY>

# A second Orchestrator, for example production, kept read-only:
# orch_2=prod
# prod_base_url=https://orchestrator.example.com
# prod_api_key=<API_KEY>

# orch_default
#   Which Orchestrator a tool call uses when it names none. A nickname (lab) or a slot (orch_2),
#   any case. Default: the lowest-numbered slot (usually orch_1).
#   A name that matches no Orchestrator is NOT reported: the lowest-numbered slot is used instead.
# orch_default=lab
# orch_default=orch_2


# =====================================================================
# 2. TLS and API key header (per Orchestrator, optional)
# =====================================================================
#
# Certificates are always verified. If your Orchestrator has a certificate
# from a public CA, you need nothing here. Otherwise pick ONE of these.
#
# a) <nickname>_ca_bundle
#    Private CA: path to the CA certificate file (PEM) that signed the Orchestrator's certificate.
#    Give the full path: ~ is NOT expanded here, and a relative path is relative to the folder
#    the server starts in. A file that does not exist stops the server: "CA bundle does not exist".
#    Default: the system's trusted CAs. If unset, the shared fallback keys in section 8
#    (orchestrator_ca_bundle, REQUESTS_CA_BUNDLE, SSL_CERT_FILE, ...) apply to this Orchestrator too.
# lab_ca_bundle=/etc/ssl/certs/my-company-root-ca.pem
#
# b) <nickname>_tls_sha256
#    Self-signed certificate: pin its SHA-256 fingerprint. Accepted: exactly 64 hex digits,
#    upper or lower case, with or without colons (no spaces). Anything else stops the server:
#    "TLS certificate pin must be a SHA-256 fingerprint (64 hex digits, colons allowed)".
#    A pin replaces the CA and hostname checks; it is checked on every connection. If both a and
#    b are set, the pin is what counts (the CA file must still exist).
#    Get it with the command below, and compare it with what the Orchestrator console
#    shows, so you know you are pinning the real server:
#      openssl s_client -connect <ORCHESTRATOR>:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
#    After a certificate renewal the pin no longer matches, and calls fail until you update it.
# lab_tls_sha256=AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89
# lab_tls_sha256=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
#
# <nickname>_api_key_header
#   HTTP header the API key is sent in. Default: X-Auth-Token. Any header name; not checked,
#   so a wrong name shows up as authentication errors from the Orchestrator. Only change it if
#   your Orchestrator expects another one. If unset, the section 8 fallback keys apply.
# lab_api_key_header=X-Auth-Token


# =====================================================================
# 3. What the assistant may change (per Orchestrator)
# =====================================================================
#
# Every Orchestrator is READ-ONLY until you opt in.
#
# How the on/off switches are read (case does not matter, spaces are trimmed):
#   _mcp_writes, _mcp_passthrough, _mcp_get_only   ON only for: 1, true, yes.
#       Anything else is OFF without a warning, including on, y, enabled and typos.
#   _mcp_confirm_writes                             OFF only for: 0, false, no, off.
#       Anything else, or unset, is ON.
#
# <nickname>_mcp_writes   Default: off.
#   Allow api_write (POST/PUT/PATCH/DELETE) on this Orchestrator. Turn it on for
#   lab Orchestrators, or deliberately; leave production read-only.
# lab_mcp_writes=true
#
# <nickname>_mcp_passthrough   Default: off.
#   Also allow writes through the raw passthroughs /appliance/rest and /broadcastCli.
#   These forward any request to an appliance's own API or CLI, so the spec can't limit
#   what they change. Needs _mcp_writes=true as well; on its own it allows nothing.
# lab_mcp_passthrough=true
#
# <nickname>_mcp_confirm_writes   Default: on.
#   Two-step writes. The first api_write call sends nothing: it returns the
#   exact change and a one-time confirmation code. The assistant shows you the change and
#   only after your yes repeats the identical call with the code. A code is good for one
#   use, 10 minutes, the identical request and the client it was issued to.
#   Turn it off only for unattended automation you trust.
# lab_mcp_confirm_writes=false
#
# <nickname>_mcp_get_only   Default: off.
#   Three POSTs are reads (POST /alarm/appliance, /stats/aggregate/interface, /health) and run
#   through api_read_post even with writes off, without confirmation, on the read rate limit.
#   For an Orchestrator whose API key must only ever see GETs, turn them off. This also
#   refuses every api_write on it, even with _mcp_writes=true. Reports then skip those POSTs.
# lab_mcp_get_only=true
#
# <nickname>_mcp_allow_high_risk   Default: none (every high-risk write refused).
#   High-risk writes stay refused even with writes on, unless you name their category.
#   Comma-separated (spaces and case do not matter), or "all". The categories:
#     auth                 users, roles, RADIUS/TACACS/LDAP/SAML, API keys, sessions, passwords
#     certificates         certificates, SSL/TLS and cipher settings
#     licensing            licences
#     backup_restore       backups and restores
#     upgrade              software images and upgrades
#     reboot               reboot, shutdown, restart, power off, factory reset
#     orchestrator_ha      Orchestrator HA and failover
#     appliance_lifecycle  approve/deny/revoke/delete appliances, hostnames, EdgeHA, HA groups
#     cloud_deployment     cloud deployment
#     provisioning         RMA, ZTP, registration, account keys, portal, preconfig apply
#     orchestrator_admin   session timeout, REST API config, advanced properties, SMTP, partitions
#     identity_events      ClearPass events
#     cli                  broadcast CLI, shell, tcpdump and packet capture
#     ip_allowlist         IP allow lists
#     traffic_disruptive   network memory erase, flow reset, DHCP reset
#   An unknown name stops the server: "lab_mcp_allow_high_risk has unknown categories: ...".
#   See exactly what is refused with:  edgeconnect-mcp --dotenv .env --list-high-risk lab
# lab_mcp_allow_high_risk=reboot,upgrade
# lab_mcp_allow_high_risk=all


# =====================================================================
# 4. Rate limits and API spec (per Orchestrator, optional)
# =====================================================================
#
# <nickname>_mcp_read_rate    Default: 10 requests per second.
# <nickname>_mcp_write_rate   Default: 2 requests per second.
#   Over the limit, calls wait instead of failing. Bursts of twice the rate (at least 1) are
#   allowed. Any number, decimals allowed (0.5 = one request every 2 seconds).
#   0 (or a negative number) = no limit. Not a number stops the server:
#   "lab_mcp_read_rate and lab_mcp_write_rate must be numbers (requests per second, 0 for no limit)".
#   Reads are GETs and the three read-only POSTs; writes are api_write calls.
# lab_mcp_read_rate=10
# lab_mcp_write_rate=2
#
# <nickname>_openapi   Default: download.
#   The server downloads the API spec from the Orchestrator (/gms/rest/apiDocs) on first use.
#   To use a saved copy instead (offline, or to pin a version), give one JSON file
#   or a folder of *.json files (~ is expanded). Not checked at startup: a missing or broken
#   file makes the first tool call that needs the spec fail.
# lab_openapi=/home/me/edgeconnect/lab-apiDocs.json
# lab_openapi=/home/me/edgeconnect/specs/


# =====================================================================
# 5. Audit log
# =====================================================================
#
# Every tool call is recorded: UTC timestamp, weekday, session, client address, tool,
# Orchestrator, method, path, what the operation does (its API summary), for writes the
# step (awaiting_confirmation, confirmed or executed) and the request body, the query,
# outcome, error, duration and response size. Secrets never reach the log: bodies hold
# <REDACTED:...> tokens, and any secret typed in clear under a secret-named key is masked.
#
# mcp_audit_log   Default: ~/.edgeconnect-mcp/audit.jsonl (on).
#   JSON-lines file, mode 600; its folder is created (mode 700) if missing; ~ is expanded.
#   OFF only for: off, none, false, 0 (any case). Any other text is taken as a file path, so
#   "no" would create a file named no. An empty value means the default.
# mcp_audit_log=~/.edgeconnect-mcp/audit.jsonl
# mcp_audit_log=off
#
# mcp_audit_syslog   Default: none (off). Empty = off.
#   Also send each record to a syslog server (facility authpriv). Accepted:
#     a local socket path starting with /    (/dev/log on Linux, /var/run/syslog on macOS)
#     udp://host[:port] or tcp://host[:port]  (port defaults to 514)
#   Anything else stops the server: "mcp_audit_syslog must be udp://host:port, tcp://host:port
#   or a local socket path". A tcp:// server it cannot reach at startup stops it too
#   ("cannot connect"); UDP and local-socket problems show up later, on stderr, per record.
#   Note "off" is not an off value here: leave the key unset instead.
#   Plain syslog is not encrypted, so prefer the local syslog daemon (rsyslog, syslog-ng) and
#   let it forward over TLS:
#     Linux local daemon:   mcp_audit_syslog=/dev/log
#     macOS local daemon:   mcp_audit_syslog=/var/run/syslog
#     UDP on a trusted net: mcp_audit_syslog=udp://192.0.2.20:514
#     TCP on a trusted net: mcp_audit_syslog=tcp://192.0.2.20:514
#   Records over 8 KB go to syslog without the body (the file and SQLite keep it).
#   Syslog is a copy, not the record of truth: records sent while the server is down are
#   missing there (stderr says so). Over TCP the next record after it returns reconnects.
#   The file and SQLite keep every record.
# mcp_audit_syslog=/dev/log
#
# mcp_audit_sqlite   Default: none (off). Empty = off.
#   Also write each record to this SQLite database file (created mode 600, ~ expanded).
#   Any value is a path: "off" here would create a file named off. For queries such as
#     sqlite3 ~/.edgeconnect-mcp/audit.db "SELECT ts, client, method, path, phase, outcome FROM audit WHERE method != 'GET'"
# mcp_audit_sqlite=~/.edgeconnect-mcp/audit.db


# =====================================================================
# 6. HTTP mode (only with --http PORT; stdio needs none of this)
# =====================================================================
#
# HTTP mode is for clients that need a URL. Put an HTTPS reverse proxy (Caddy,
# Nginx Proxy Manager) in front of it; see docs/remote-access.md.
# With HTTP mode on, the server refuses to start if this file is readable by
# other users (chmod 600 .env). These keys are only read and checked with --http.
#
# mcp_http_token   Required in HTTP mode. No default.
#   Access token, at least 32 characters (spaces around it are trimmed). Shorter or missing
#   stops the server: "HTTP mode needs mcp_http_token ... of at least 32 characters".
#   Generate one with:
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#   Clients send it as:  Authorization: Bearer <token>
# mcp_http_token=<PASTE_A_LONG_RANDOM_TOKEN>
#
# mcp_http_read_token   Optional. Default: none.
#   Second token that can read (api_get, api_read_post) but can never call api_write.
#   Give this one to people or tools that only need to look. Also at least 32 characters, and
#   it must differ from mcp_http_token ("mcp_http_read_token must differ from mcp_http_token").
# mcp_http_read_token=<PASTE_ANOTHER_LONG_RANDOM_TOKEN>
#
# mcp_http_allowed_clients   Default: 127.0.0.1,::1 (this machine only). Empty = default.
#   Networks allowed to connect: IPv4 or IPv6 addresses or CIDR subnets, comma-separated.
#   Host bits are ignored (192.0.2.15/24 means 192.0.2.0/24). An entry that is not an address
#   or subnet stops the server with "mcp_http_allowed_clients: <reason>".
#   A refused client gets an error naming the address the server saw, so you know what to add.
#   Examples:
#     your laptop's VPN range:       mcp_http_allowed_clients=192.0.2.0/24
#     two office subnets:            mcp_http_allowed_clients=192.0.2.0/26,192.0.2.128/26
#     one admin workstation:         mcp_http_allowed_clients=192.0.2.15
# mcp_http_allowed_clients=127.0.0.1,::1
#
# mcp_http_trusted_proxies   Default: 127.0.0.1,::1. Empty = default. Same format as above.
#   Proxies whose X-Forwarded-For header is believed. When a request comes from one of
#   these, the client is the last address the proxy added. From anyone else the header
#   is ignored, so a client can't pretend to be an allowed address.
#   The default fits a proxy on the same machine (Caddy, nginx).
#   Example, Nginx Proxy Manager in Docker on a network with subnet 172.30.0.0/24:
#     mcp_http_trusted_proxies=172.30.0.0/24
# mcp_http_trusted_proxies=127.0.0.1,::1
#
# mcp_http_listen   Default: 127.0.0.1, so plain HTTP never leaves the machine.
#   Address the server listens on: one IPv4 or IPv6 address, not a host name. Anything else
#   stops the server: "mcp_http_listen must be an IP address such as 127.0.0.1 or 0.0.0.0".
#   The container image sets 0.0.0.0 (inside the container only); compose.yaml then publishes
#   the port on the host's 127.0.0.1. You should not need to change this outside a container.
#   The port is not a setting: it is the --http PORT option.
# mcp_http_listen=127.0.0.1
#
# mcp_http_allowed_origins   Default: none, so web pages open in a browser can't call it.
#   Browser origins allowed to call the server, comma-separated, as scheme://host[:port]
#   (case and a trailing / do not matter; not otherwise checked, and * is not a wildcard).
#   Requests without an Origin header (non-browser clients) are not affected.
#   Only set this for a browser-based MCP client.
# mcp_http_allowed_origins=https://my-mcp-client.example.com
#
# Putting it together:
#
#   Server on this machine, Caddy in front, clients on the LAN 192.0.2.0/24:
#     mcp_http_token=<token>
#     mcp_http_allowed_clients=192.0.2.0/24
#     (Caddy connects from 127.0.0.1, which the default trusted proxies already cover.)
#
#   Server container behind Nginx Proxy Manager on Docker network 172.30.0.0/24,
#   clients on the VPN 192.0.2.0/24:
#     mcp_http_token=<token>
#     mcp_http_trusted_proxies=172.30.0.0/24
#     mcp_http_allowed_clients=192.0.2.0/24


# =====================================================================
# 7. Environment only (set in the shell or the client config, not in this file)
# =====================================================================
#
# EDGECONNECT_DOTENV   Path of the settings file to read, used when --dotenv is not given.
#   Set, it replaces the search for ~/.edgeconnect-mcp/.env and ./.env. A file that does not
#   exist stops the server with the operating system's "No such file" error.
#   setup.sh's launcher passes it through to the shared .env.
#   export EDGECONNECT_DOTENV=/home/me/edgeconnect/.env
#
# SSH_CLIENT   Set by sshd, never by you. When the server runs over SSH, the caller's address
#   from it is recorded as the client in the audit log.


# =====================================================================
# 8. Single-Orchestrator keys (older form, optional)
# =====================================================================
#
# Instead of orch_1=<nickname>, one Orchestrator can be given without a nickname. Its name is
# then "orchestrator", and the per-Orchestrator switches above use that prefix
# (orchestrator_mcp_writes=true, orchestrator_mcp_read_rate=5, orchestrator_openapi=...).
# These keys must be spelled exactly as shown, in the case shown. For each value the
# environment is checked first, then this file, and the first name in each list that has a
# value wins. Same accepted values as the per-nickname keys in sections 1 and 2.
#
#   base URL:    orchestrator_base_url, ORCHESTRATOR_BASE_URL, EDGECONNECT_BASE_URL, EC_BASE_URL
#   API key:     orchestrator_api_key, ORCHESTRATOR_API_KEY, EDGECONNECT_API_KEY, EC_API_KEY
#   TLS pin:     orchestrator_tls_sha256, ORCHESTRATOR_TLS_SHA256
#   CA file:     orchestrator_ca_bundle, ORCHESTRATOR_CA_BUNDLE, EDGECONNECT_CA_BUNDLE,
#                REQUESTS_CA_BUNDLE, SSL_CERT_FILE
#   key header:  orchestrator_api_key_header, ORCHESTRATOR_API_KEY_HEADER, EDGECONNECT_API_KEY_HEADER
#
# Once any orch_<N> slot is set, the server ignores the base URL and API key lines here,
# without a warning. The CA file and key header lines still apply, as the fallback for
# every nickname that sets no _ca_bundle or _api_key_header of its own. So a REQUESTS_CA_BUNDLE
# or SSL_CERT_FILE in your environment becomes the CA file for those Orchestrators too.
# orchestrator_base_url=https://orchestrator.example.com
# orchestrator_api_key=<API_KEY>
# orchestrator_tls_sha256=<SHA-256 fingerprint>
# orchestrator_mcp_writes=true


# =====================================================================
# 9. Values that are not checked (they fall back without a warning)
# =====================================================================
#
#   _mcp_writes, _mcp_passthrough, _mcp_get_only    anything but 1/true/yes is off (on, y, enabled)
#   _mcp_confirm_writes                             anything but 0/false/no/off is on
#   orch_default                                    an unknown name uses the lowest-numbered slot
#   _mcp_read_rate, _mcp_write_rate                 a negative number means no limit
#   mcp_audit_log                                   any value other than off/none/false/0 is a path
#   mcp_audit_sqlite                                any value is a path
#   _api_key_header, mcp_http_allowed_origins       any text is accepted
#   _openapi                                        checked only on first use
#   orchestrator_base_url / _api_key (section 8)    ignored once an orch_<N> slot is set
